diff --git a/tests/exercise_b/test_batch.py b/tests/exercise_b/test_batch.py
new file mode 100644
index 0000000..4d173ba
--- /dev/null
+++ b/tests/exercise_b/test_batch.py
@@ -0,0 +1,47 @@
+from typing import Any
+
+from triage_by_agent.router import process_batch, route_raw
+
+
+def raw(**kw: Any) -> dict[str, Any]:
+    base: dict[str, Any] = dict(
+        issue_number=1,
+        repo="hono",
+        issue_type="bug",
+        component="middleware",
+        severity="medium",
+        has_reproduction_steps="true",
+        confidence="0.9",
+    )
+    base.update(kw)
+    return base
+
+
+def issue(n: int, title: str) -> dict[str, Any]:
+    return {"number": n, "title": title, "body": "x" * 40, "repo": "hono"}
+
+
+def test_route_raw_maps_queue() -> None:
+    assert route_raw(raw()).queue == "engineering"
+
+
+def test_route_raw_critical_escalates() -> None:
+    r = route_raw(raw(severity="critical"))
+    assert r.escalate
+    assert r.sla_hours == 4
+
+
+def test_empty_batch() -> None:
+    report = process_batch([], [])
+    assert report.routings == []
+    assert report.duplicate_pairs == []
+
+
+def test_batch_routes_each_issue() -> None:
+    report = process_batch([raw()], [issue(1, "a")])
+    assert [r.queue for r in report.routings] == ["engineering"]
+
+
+def test_batch_reports_no_duplicates_for_a_single_issue() -> None:
+    report = process_batch([raw()], [issue(1, "cannot start the server")])
+    assert report.duplicate_pairs == []
diff --git a/tests/exercise_b/test_router.py b/tests/exercise_b/test_router.py
new file mode 100644
index 0000000..8ed06ec
--- /dev/null
+++ b/tests/exercise_b/test_router.py
@@ -0,0 +1,40 @@
+from typing import Any
+
+from triage_by_agent.router import route
+from triage_by_agent.schema import TriageRecord
+
+
+def rec(**kw: Any) -> TriageRecord:
+    base: dict[str, Any] = dict(
+        issue_number=1,
+        repo="hono",
+        issue_type="bug",
+        component="middleware",
+        severity="medium",
+        has_reproduction_steps=True,
+        confidence=0.9,
+    )
+    base.update(kw)
+    return TriageRecord(**base)
+
+
+def test_bug_goes_to_engineering() -> None:
+    assert route(rec()).queue == "engineering"
+
+
+def test_bug_without_repro_is_held() -> None:
+    assert route(rec(has_reproduction_steps=False)).queue == "triage-clarify"
+
+
+def test_critical_escalates() -> None:
+    r = route(rec(severity="critical"))
+    assert r.escalate
+    assert r.sla_hours == 4
+
+
+def test_low_confidence_high_severity_escalates() -> None:
+    assert route(rec(severity="high", confidence=0.4)).escalate
+
+
+def test_enhancement_goes_to_product() -> None:
+    assert route(rec(issue_type="enhancement")).queue == "product"
